{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terrsola/jmri-tc/blob/main/catalogue-marklin-digital.schema.json",
  "title": "JMRI-TC Märklin digital catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locomotives",
    "accessories"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "locomotives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locomotive"
      }
    },
    "accessories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accessory"
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "locomotive": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "const": "DCC"
                },
                "addressType": {
                  "enum": [
                    "S",
                    "L"
                  ]
                },
                "address": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10239
                },
                "wiThrottleId": {
                  "type": "string"
                },
                "rosterId": {
                  "type": "string"
                },
                "functions": {
                  "type": "array",
                  "maxItems": 32
                }
              },
              "required": [
                "protocol",
                "addressType",
                "address",
                "wiThrottleId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "const": "MM2"
                },
                "addressType": {
                  "const": "MM2"
                },
                "address": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "wiThrottleId": {
                  "type": "null"
                }
              },
              "required": [
                "protocol",
                "addressType",
                "address",
                "wiThrottleId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "const": "MFX"
                },
                "addressType": {
                  "const": "DYNAMIC_MFX"
                },
                "mfxUid": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{6,16}$"
                },
                "address": {
                  "type": "null"
                },
                "wiThrottleId": {
                  "type": "null"
                }
              },
              "required": [
                "protocol",
                "addressType",
                "mfxUid",
                "address",
                "wiThrottleId"
              ]
            }
          ]
        }
      ]
    },
    "accessory": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "enum": [
                "DCC",
                "MM2",
                "MFX"
              ]
            },
            "type": {
              "enum": [
                "TURNOUT",
                "SIGNAL",
                "LIGHT",
                "UNCOUPLER",
                "RELAY",
                "OTHER"
              ]
            },
            "systemName": {
              "type": "string",
              "minLength": 1
            },
            "feedbackSystemName": {
              "type": "string"
            },
            "levelId": {},
            "notes": {
              "type": "string"
            },
            "address": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "mfxUid": {
              "type": "string",
              "pattern": "^[0-9A-F]{6,16}$"
            }
          },
          "required": [
            "protocol",
            "type",
            "systemName"
          ]
        }
      ]
    }
  }
}
