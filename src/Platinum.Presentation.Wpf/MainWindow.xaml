<Window x:Class="Platinum.Presentation.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="clr-namespace:Platinum.Presentation.Wpf.Editor" xmlns:editor3d="clr-namespace:Platinum.Presentation.Wpf.Editor" xmlns:native="clr-namespace:Platinum.Presentation.Wpf" Title="Quiral Platinum — Maquetisme ferroviari" Height="900" Width="1500" MinHeight="650" MinWidth="1050" Background="#FF111820" Foreground="#FFE9EDF2">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF202833" Padding="16">
      <DockPanel><StackPanel><TextBlock Text="QUIRAL PLATINUM" FontSize="21" FontWeight="Bold" Foreground="#FFFFC65C"/><TextBlock Text="Control natiu de maquetes ferroviàries · .NET 10" Foreground="#FFB7C1CC"/></StackPanel><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" x:Name="ProjectStatus" Text="PROJECTE NO DESAT" Foreground="#FFFFC65C" FontWeight="SemiBold"/></DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#FF202833" Padding="8"><TextBlock x:Name="StatusText" Text="Preparat · Sortides físiques bloquejades per defecte · Cap maquinari connectat" Foreground="#FFB7C1CC"/></Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FF1A222C" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PANELS" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/><TreeView Background="Transparent" Foreground="#FFE9EDF2" BorderThickness="0"><TreeViewItem Header="Projecte" IsExpanded="True"><TreeViewItem Header="Editor 2D"/><TreeViewItem Header="Nivells i capes"/><TreeViewItem Header="Catàleg de vies"/></TreeViewItem><TreeViewItem Header="Operacions"><TreeViewItem Header="Dispatcher i itineraris"/><TreeViewItem Header="Circulacions DCC"/><TreeViewItem Header="Senyalització"/></TreeViewItem><TreeViewItem Header="Diagnòstic i seguretat"><TreeViewItem Header="Sensors i blocs"/><TreeViewItem Header="Validació física"/><TreeViewItem Header="Diagnòstic JMRI"/></TreeViewItem><TreeViewItem Header="Simuladors"><TreeViewItem Header="Cabina de locomotora"/><TreeViewItem Header="Protecció de tren"/><TreeViewItem Header="Terminal tren-terra"/><TreeViewItem Header="Món de Jocs"/></TreeViewItem></TreeView></DockPanel></Border>
      <Grid Grid.Column="1" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,10"><Button Content="Nou projecte" Padding="14,7" Margin="0,0,8,0" Click="NewProject_Click"/><Button Content="Obrir…" Padding="14,7" Margin="0,0,8,0" Click="OpenProject_Click"/><Button Content="Desar" Padding="14,7" Margin="0,0,8,0" Click="SaveProject_Click"/><Button Content="Actualitzar des de GitHub" Padding="14,7" Click="CheckUpdates_Click"/><TextBlock Text="Nivell:" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox x:Name="LevelSelector" Width="150" Padding="6" VerticalContentAlignment="Center" SelectionChanged="LevelSelector_SelectionChanged"/></WrapPanel><TabControl Grid.Row="1" Background="#FF18212B" BorderBrush="#FF394654" SelectionChanged="EditorTabs_SelectionChanged"><TabItem Header="Editor 2D"><Border Background="#FF18212B"><editor:TrackEditorView x:Name="TrackEditor"/></Border></TabItem><TabItem Header="Editor 3D"><Border Background="#FF10171F"><editor3d:ThreeDTrackEditorView x:Name="TrackEditor3D"/></Border></TabItem><TabItem Header="Operacions natives"><native:NativeOperationsView/></TabItem></TabControl></Grid>
      <Border Grid.Column="2" Background="#FF1A222C" Padding="14"><StackPanel><TextBlock Text="PROPIETATS" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Editor de vies natiu" Foreground="#FFB7C1CC"/>
        <Separator Margin="0,14"/>
        <TextBlock Text="CATÀLEG MÄRKLIN C · H0" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="CatalogueSearch" Padding="6" Margin="0,0,0,8" ToolTip="Cerca per referència, nom o categoria" TextChanged="CatalogueSearch_TextChanged"/>
        <ListBox x:Name="CatalogueList" Height="250" Background="#FF111820" Foreground="#FFE9EDF2" BorderBrush="#FF394654" DisplayMemberPath="DisplayName" SelectionChanged="CatalogueList_SelectionChanged"/>
        <Button x:Name="PlaceCatalogueButton" Content="Col·loca al nivell actiu" Padding="8,6" Margin="0,8,0,0" IsEnabled="False" Click="PlaceCatalogueButton_Click"/>
        <TextBlock x:Name="CatalogueDetails" Text="Selecciona una peça per consultar-ne les dades." TextWrapping="Wrap" Foreground="#FFB7C1CC" Margin="0,8,0,0"/>
        <TextBlock x:Name="CatalogueCount" Text="Catàleg no carregat" Foreground="#FFB7C1CC" Margin="0,6,0,0"/>
        <Separator Margin="0,14,0,8"/><TextBlock Text="ESTAT DEL SISTEMA" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Projecte: gestionat pel fitxer .platinum"/><TextBlock Text="JMRI: desconnectat"/><TextBlock Text="Central digital: desconnectada"/><TextBlock Text="DCC: bloquejat" Foreground="#FFFFC65C"/><TextBlock Text="E-stop físic: no verificat" Foreground="#FFFFC65C" Margin="0,0,0,10"/><Separator/><TextBlock Text="La geometria editada és un plànol lògic. No equival a validació física ni habilita sortides de maquinari." TextWrapping="Wrap" Foreground="#FFB7C1CC" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>
  </DockPanel>
</Window>
