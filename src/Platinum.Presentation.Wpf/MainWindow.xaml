<Window x:Class="Platinum.Presentation.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quiral Platinum — Maquetisme ferroviari" Height="900" Width="1500" MinHeight="650" MinWidth="1050" Background="#FF111820" Foreground="#FFE9EDF2">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF202833" Padding="16">
      <DockPanel><StackPanel><TextBlock Text="QUIRAL PLATINUM" FontSize="21" FontWeight="Bold" Foreground="#FFFFC65C"/><TextBlock Text="Control natiu de maquetes ferroviàries · .NET 10" Foreground="#FFB7C1CC"/></StackPanel><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" x:Name="ProjectStatus" Text="PROJECTE NO DESAT" Foreground="#FFFFC65C" FontWeight="SemiBold"/></DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#FF202833" Padding="8"><TextBlock x:Name="StatusText" Text="Preparat · Sortides físiques bloquejades per defecte · Cap maquinari connectat" Foreground="#FFB7C1CC"/></Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FF1A222C" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PANELS" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/><TreeView Background="Transparent" Foreground="#FFE9EDF2" BorderThickness="0"><TreeViewItem Header="Projecte" IsExpanded="True"><TreeViewItem Header="Editor 2D"/><TreeViewItem Header="Nivells i capes"/><TreeViewItem Header="Catàleg de vies"/></TreeViewItem><TreeViewItem Header="Operacions"><TreeViewItem Header="Dispatcher i itineraris"/><TreeViewItem Header="Circulacions DCC"/><TreeViewItem Header="Senyalització"/></TreeViewItem><TreeViewItem Header="Diagnòstic i seguretat"><TreeViewItem Header="Sensors i blocs"/><TreeViewItem Header="Validació física"/><TreeViewItem Header="Diagnòstic JMRI"/></TreeViewItem><TreeViewItem Header="Simuladors"><TreeViewItem Header="Cabina de locomotora"/><TreeViewItem Header="Protecció de tren"/><TreeViewItem Header="Terminal tren-terra"/><TreeViewItem Header="Món de Jocs"/></TreeViewItem></TreeView></DockPanel></Border>
      <Grid Grid.Column="1" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,10"><Button Content="Nou projecte" Padding="14,7" Margin="0,0,8,0" Click="NewProject_Click"/><Button Content="Obrir…" Padding="14,7" Margin="0,0,8,0" Click="OpenProject_Click"/><Button Content="Desar" Padding="14,7" Margin="0,0,8,0" Click="SaveProject_Click"/><Button Content="Desfer" Padding="14,7" Margin="0,0,8,0"/><Button Content="Refer" Padding="14,7"/></WrapPanel><Border Grid.Row="1" Background="#FF18212B" BorderBrush="#FF394654" BorderThickness="1" CornerRadius="6"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="ESPAI DE TREBALL" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" Foreground="#FFFFC65C"/><TextBlock Text="El nou editor WPF s'està construint per mòduls." Margin="0,10,0,0" Foreground="#FFB7C1CC"/><TextBlock Text="Aquest espai serà el llenç vectorial 2D amb zoom, nivells i selecció." Margin="0,4,0,0" Foreground="#FF8795A4"/></StackPanel></Grid></Border></Grid>
      <Border Grid.Column="2" Background="#FF1A222C" Padding="14"><StackPanel><TextBlock Text="PROPIETATS" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Cap element seleccionat" Foreground="#FFB7C1CC"/><Separator Margin="0,14"/><TextBlock Text="ESTAT DEL SISTEMA" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Projecte: no desat"/><TextBlock Text="JMRI: desconnectat"/><TextBlock Text="Central digital: desconnectada"/><TextBlock Text="DCC: bloquejat" Foreground="#FFFFC65C"/><TextBlock Text="E-stop físic: no verificat" Foreground="#FFFFC65C" Margin="0,0,0,10"/><Separator/><TextBlock Text="La interfície no habilita cap sortida física. La verificació de maquinari requereix proves independents." TextWrapping="Wrap" Foreground="#FFB7C1CC" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>
  </DockPanel>
</Window>
