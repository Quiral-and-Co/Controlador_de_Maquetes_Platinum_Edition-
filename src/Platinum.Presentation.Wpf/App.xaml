<Application x:Class="Platinum.Presentation.Wpf.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB8872B"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF202833"/>
    <SolidColorBrush x:Key="DefaultTextBrush" Color="#FFFFFFFF"/>

    <!-- Text blanc per defecte a tota la interfície WPF fosca. -->
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type TreeView}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type TreeViewItem}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type Label}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
    </Style>
  </Application.Resources>
</Application>
