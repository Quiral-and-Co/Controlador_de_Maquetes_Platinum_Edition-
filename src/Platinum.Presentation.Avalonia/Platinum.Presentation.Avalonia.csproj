<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Platinum.Domain/Platinum.Domain.csproj" />
    <ProjectReference Include="../Platinum.Application/Platinum.Application.csproj" />
    <ProjectReference Include="../Platinum.Infrastructure/Platinum.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Platinum.Presentation.Wpf/Assets/catalogue-marklin-c.json"
             Link="Assets/catalogue-marklin-c.json"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('../Platinum.Presentation.Wpf/Assets/catalogue-marklin-c.json')" />
  </ItemGroup>
</Project>
