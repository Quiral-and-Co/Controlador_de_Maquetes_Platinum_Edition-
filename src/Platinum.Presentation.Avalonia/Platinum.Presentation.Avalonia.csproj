<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="12.2.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Platinum.Domain/Platinum.Domain.csproj" />
    <ProjectReference Include="../Platinum.Application/Platinum.Application.csproj" />
    <ProjectReference Include="../Platinum.Infrastructure/Platinum.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Platinum.Presentation.Wpf/Assets/catalogue-marklin-c.json"
             Link="Assets/catalogue-marklin-c.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
