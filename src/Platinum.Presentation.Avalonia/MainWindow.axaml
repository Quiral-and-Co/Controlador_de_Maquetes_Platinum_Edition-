<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Platinum.Presentation.Avalonia.MainWindow"
        Title="Quiral Platinum"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="22,14"
            Background="#172235">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="QUIRAL PLATINUM" FontSize="20" FontWeight="Bold"
                     Foreground="White" />
          <TextBlock Text=".NET 10 · Avalonia UI" FontSize="12"
                     Foreground="#B9C6D8" />
        </StackPanel>
        <Border Grid.Column="1" Background="#244A3C" CornerRadius="14"
                Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="SIMULACIÓ / SENSE SORTIDES FÍSIQUES"
                     Foreground="#B8F2D2" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#202D40" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="ESPAI DE TREBALL" Foreground="#9FB0C8"
                   FontSize="11" FontWeight="Bold" Margin="8,8,0,10" />
        <Button Content="Editor de maqueta" HorizontalContentAlignment="Left" />
        <Button Content="Catàleg Märklin" HorizontalContentAlignment="Left" />
        <Button Content="Dispatcher" HorizontalContentAlignment="Left" />
        <Button Content="Senyalització" HorizontalContentAlignment="Left" />
        <Button Content="Locomotores" HorizontalContentAlignment="Left" />
        <Button Content="Protocols i connexions" HorizontalContentAlignment="Left" />
        <Button Content="Validació i diagnòstic" HorizontalContentAlignment="Left" />
        <Border Height="1" Background="#40516A" Margin="4,14" />
        <TextBlock Text="MIGRACIÓ" Foreground="#9FB0C8"
                   FontSize="11" FontWeight="Bold" Margin="8,0,0,4" />
        <TextBlock Text="La capa Avalonia s'està construint sobre els mateixos projectes Domain, Application i Infrastructure."
                   Foreground="#D2DCE9" TextWrapping="Wrap" Margin="8,0,8,0"
                   FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="32" Spacing="22" MaxWidth="1000">
        <StackPanel Spacing="6">
          <TextBlock Text="Centre de control" FontSize="30" FontWeight="Bold" />
          <TextBlock Text="Base multiplataforma de Quiral Platinum. Aquesta primera fase valida l'arrencada d'Avalonia i la reutilització de la capa de negoci."
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="8">
              <TextBlock Text="DOMINI" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Compartit" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Model de maqueta i regles sense dependència de la UI."
                         TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="8">
              <TextBlock Text="APLICACIÓ" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Compartida" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Casos d'ús i contractes reutilitzats per WPF i Avalonia."
                         TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="8">
              <TextBlock Text="INFRAESTRUCTURA" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Compartida" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Persistència .platinum i adaptadors independents."
                         TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="22">
          <StackPanel Spacing="12">
            <TextBlock Text="Estat de la migració" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Fase 1 · Shell Avalonia operatiu com a projecte independent."
                       FontWeight="SemiBold" />
            <TextBlock Text="WPF es manté temporalment per preservar la versió Windows existent. Els mòduls de l'editor, dispatcher, senyalització i control es migraran individualment, amb proves de paritat abans de retirar cada vista antiga."
                       TextWrapping="Wrap" />
            <TextBlock Text="Seguretat: les ordres físiques continuen bloquejades. Aquesta interfície inicial no connecta ni envia ordres a cap central."
                       TextWrapping="Wrap" Foreground="#B45309" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
