<Window x:Class="Platinum.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:Platinum.Presentation.Avalonia.Editor"
    xmlns:dispatcher="using:Platinum.Presentation.Avalonia.Dispatcher"
    xmlns:operations="using:Platinum.Presentation.Avalonia.Operations"
    Title="Quiral Platinum — Maquetisme ferroviari" Width="1500" Height="900" MinWidth="1100" MinHeight="680">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#202833" Padding="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2"><TextBlock Text="QUIRAL PLATINUM" FontSize="21" FontWeight="Bold" Foreground="#FFC65C"/><TextBlock Text="Control natiu de maquetes ferroviàries · Avalonia UI · .NET 10" Foreground="#B7C1CC"/></StackPanel>
        <TextBlock x:Name="ProjectStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="#FFC65C" Text="PROJECTE NO DESAT"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#202833" Padding="8"><TextBlock x:Name="StatusText" Text="Preparat · Sortides físiques bloquejades per defecte · Cap maquinari connectat" Foreground="#B7C1CC"/></Border>
    <Grid ColumnDefinitions="220,*,285">
      <Border Grid.Column="0" Background="#1A222C" Padding="12"><StackPanel Spacing="10">
        <TextBlock Text="PLATINUM" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="PROJECTE" Foreground="#FFC65C" FontWeight="SemiBold"/><TextBlock Text="Editor 2D · Editor 3D · Catàleg"/>
        <TextBlock Text="OPERACIONS" Foreground="#FFC65C" FontWeight="SemiBold"/><TextBlock Text="Dispatcher · Blocs · Itineraris"/>
        <TextBlock Text="DIAGNÒSTIC I SEGURETAT" Foreground="#FFC65C" FontWeight="SemiBold"/><TextBlock Text="Sensors · Senyalització · Validació"/>
        <TextBlock Text="SIMULADORS" Foreground="#FFC65C" FontWeight="SemiBold"/><TextBlock Text="Cabina · Protecció · Tren-terra"/>
      </StackPanel></Border>
      <Grid Grid.Column="1" Margin="10" RowDefinitions="Auto,*">
        <WrapPanel><Button Content="Nou projecte" Click="NewProject_Click"/><Button Content="Obrir…" Click="OpenProject_Click"/><Button Content="Desar" Click="SaveProject_Click"/><Button Content="Actualitzar des de GitHub" Click="CheckUpdates_Click"/>
          <TextBlock Text="Nivell:" VerticalAlignment="Center" Margin="12,0,4,0"/><ComboBox x:Name="LevelSelector" Width="145" SelectionChanged="LevelSelector_SelectionChanged"/></WrapPanel>
        <TabControl Grid.Row="1" Margin="0,8,0,0">
          <TabItem Header="Editor 2D"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Seleccionar" Click="SelectTool_Click"/><Button Content="Via recta" Click="StraightTool_Click"/><Button Content="Corba" Click="CurveTool_Click"/><Button Content="Desviament" Click="TurnoutTool_Click"/><Separator/><Button Content="Desfer" Click="Undo_Click"/><Button Content="Refer" Click="Redo_Click"/><Button Content="Eliminar" Click="Delete_Click"/><Button Content="−15°" Click="RotateMinus_Click"/><Button Content="+15°" Click="RotatePlus_Click"/><Button Content="90°" Click="Rotate90_Click"/><Button Content="Connectar ports" Click="ConnectPorts_Click"/><Button Content="Zoom +" Click="ZoomIn_Click"/><Button Content="Zoom −" Click="ZoomOut_Click"/><Button Content="Ajustar" Click="FitView_Click"/></WrapPanel><editor:TrackPlanView x:Name="TrackPlan"/></DockPanel></TabItem>
          <TabItem Header="Editor 3D"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Superior" Click="ThreeDTop_Click"/><Button Content="Isomètrica" Click="ThreeDIso_Click"/><Button Content="Lateral" Click="ThreeDSide_Click"/><Button Content="Zoom +" Click="ThreeDZoomIn_Click"/><Button Content="Zoom −" Click="ThreeDZoomOut_Click"/></WrapPanel><editor:ThreeDTrackView x:Name="TrackPlan3D"/></DockPanel></TabItem>
          <TabItem Header="Dispatcher"><dispatcher:DispatcherView x:Name="DispatcherPanel"/></TabItem>
          <TabItem Header="Operacions"><operations:OperationsView x:Name="OperationsPanel"/></TabItem>
        </TabControl>
      </Grid>
      <Border Grid.Column="2" Background="#1A222C" Padding="12"><StackPanel Spacing="8">
        <TextBlock Text="PROPIETATS I CATÀLEG" FontSize="15" FontWeight="Bold"/><TextBlock Text="MÄRKLIN C · H0" FontWeight="Bold" Foreground="#FFC65C"/>
        <TextBox x:Name="CatalogueSearch" PlaceholderText="Cerca per referència o nom" TextChanged="CatalogueSearch_TextChanged"/>
        <ListBox x:Name="CatalogueList" Height="280" SelectionChanged="CatalogueList_SelectionChanged"/>
        <Button x:Name="PlaceCatalogueButton" Content="Col·loca al nivell actiu" IsEnabled="False" Click="PlaceCatalogueButton_Click"/>
        <TextBlock x:Name="CatalogueDetails" Text="Selecciona una peça per consultar-ne les dades." TextWrapping="Wrap" Foreground="#B7C1CC"/>
        <TextBlock x:Name="CatalogueCount" Text="Catàleg no carregat" Foreground="#B7C1CC"/>
        <Separator/><TextBlock Text="SEGURETAT" FontWeight="Bold" Foreground="#FFC65C"/>
        <TextBlock Text="Sortides físiques: BLOQUEJADES" FontWeight="SemiBold"/>
        <TextBlock Text="La geometria i les reserves són lògiques; no equivalen a validació física ni a un enclavament ferroviari certificat." TextWrapping="Wrap" Foreground="#B7C1CC"/>
      </StackPanel></Border>
    </Grid>
  </DockPanel>
</Window>