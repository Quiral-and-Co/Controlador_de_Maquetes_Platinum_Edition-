<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Platinum.Presentation.Avalonia.Views.DashboardView">
  <StackPanel Spacing="18">
    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75"/>
    <Border Padding="20" CornerRadius="10" Background="#E8F3EC">
      <StackPanel Spacing="8">
        <TextBlock Text="ARQUITECTURA" FontWeight="Bold" Foreground="#24543B"/>
        <TextBlock Text="MVVM · DI · navegació per pàgines · serveis de diàleg" FontSize="18" Foreground="#24543B"/>
        <TextBlock Text="{Binding MigrationStatus}" Foreground="#24543B"/>
      </StackPanel>
    </Border>
    <Border Padding="20" CornerRadius="10" BorderBrush="#D4DCE5" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Seguretat" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SafetyStatus}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>