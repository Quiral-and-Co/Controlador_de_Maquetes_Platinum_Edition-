<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Platinum.Presentation.Avalonia.Views.CatalogueView">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
    <TextBlock Text="El catàleg es connectarà a les dades compartides a la fase corresponent." Opacity="0.7"/>
  </StackPanel>
</UserControl>